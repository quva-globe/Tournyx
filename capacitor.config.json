{
  "appId": "in.tournyx.app",
  "appName": "Tournyx Esports",
  "webDir": "www",
  "server": {
    "hostname": "app.tournyx.in",
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "app.tournyx.in",
      "tournyx.in",
      "*.tournyx.in",
      "*.supabase.co",
      "api.bigdatacloud.net",
      "*.youtube.com",
      "youtu.be"
    ]
  },
  "android": {
    "backgroundColor": "#050508",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#050508",
    "contentInset": "never",
    "scrollEnabled": true,
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#050508",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050508",
      "overlaysWebView": false
    }
  }
}
